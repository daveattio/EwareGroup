# Base de Données PostgreSQL
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=generer_un_mot_de_passe_securise_ici

# Strapi Sécurité & JWT (Générer des chaînes aléatoires 32 caractères)
APP_KEYS=cle1_aleatoire_base64,cle2_aleatoire_base64,cle3_aleatoire_base64,cle4_aleatoire_base64
API_TOKEN_SALT=cle_salt_aleatoire_32_chars
ADMIN_JWT_SECRET=cle_jwt_admin_aleatoire_32_chars
TRANSFER_TOKEN_SALT=cle_transfert_aleatoire_32_chars
JWT_SECRET=cle_jwt_publique_aleatoire_32_chars

# URLs publiques pour le Proxy Dokploy / Traefik
PUBLIC_STRAPI_URL=https://admin.ewaregroup.org
NUXT_PUBLIC_SITE_URL=https://ewaregroup.org
