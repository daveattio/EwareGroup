{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "togo",
        "benin",
        "solsizer",
        "mobility",
        "eimat",
        "global"
      ]
    },
    "tag": {
      "type": "string"
    },
    "readTime": {
      "type": "string"
    },
    "summary": {
      "type": "text"
    },
    "content": {
      "type": "blocks"
    },
    "cover": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
